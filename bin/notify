#!/bin/sh
# Usage: notify <title> <message>

title="${1:-Notification}"
message="${2:-}"

case "$(uname -s)" in
    Darwin)
        esc_title=$(printf '%s' "$title" | sed 's/\\/\\\\/g; s/"/\\"/g')
        esc_message=$(printf '%s' "$message" | sed 's/\\/\\\\/g; s/"/\\"/g')
        osascript -e "display notification \"$esc_message\" with title \"$esc_title\""
        ;;
    *)
        # PowerShell single-quoted strings escape a literal ' by doubling it.
        esc_title=$(printf '%s' "$title" | sed "s/'/''/g")
        esc_message=$(printf '%s' "$message" | sed "s/'/''/g")
        pwsh.exe -Command "New-BurntToastNotification -UniqueIdentifier 'notify' -Text '$esc_title','$esc_message'"
        ;;
esac
