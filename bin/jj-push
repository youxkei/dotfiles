#!/bin/sh
# Usage: jj-push [jj git push options...]
# Pushes the bookmarks that point at @, then leaves them on @.
# Invoked as `jj push` through the alias in jj/config.toml.
set -e

# The names are read out first rather than left to `jj git push -r @`, which only
# warns and exits 0 when @ carries no bookmark: reaching for this and pushing
# nothing is a mistake worth failing on. The names are also what the loop at the
# end needs.
names=$(jj log -r @ --no-graph -T 'local_bookmarks.map(|b| b.name())')

if [ -z "$names" ]; then
    echo "jj push: no bookmark at @" >&2
    exit 1
fi

# The flags join the caller's own options in $@ rather than accumulating in a
# string that the call site would have to leave unquoted. Splitting $names on
# whitespace is good enough: jj does accept a quoted bookmark name containing a
# space, but Git refuses to export one, so it could not be pushed either way.
for name in $names; do
    set -- "$@" --bookmark "$name"
done

jj git push "$@"

# Not redundant with a bookmark that simply follows @: pushing one that trunk()
# resolves to (main, master) makes the pushed commit immutable, and jj answers
# that by moving @ onto a fresh empty commit carrying no bookmark at all. Putting
# the names back on @ is what lets the next run find something to push. For a
# bookmark outside trunk() nothing becomes immutable, @ stays put, and this is a
# no-op.
for name in $names; do
    jj bookmark set "$name" -r @
done
